# 《蓝血》NPC 对话服务配置模板。
# 复制成 .env.local 后填入真实值；.env.local 已被 .gitignore 排除，不要提交。

# ---- 大模型（OpenAI 兼容的 /chat/completions 接口）----
# 三家常用的写法，按你实际用的那家填：
#   DeepSeek   https://api.deepseek.com/v1                    模型 deepseek-chat
#   智谱 GLM   https://open.bigmodel.cn/api/paas/v4           模型 glm-4-flash
#   通义千问   https://dashscope.aliyuncs.com/compatible-mode/v1  模型 qwen-plus
#   月之暗面   https://api.moonshot.cn/v1                     模型 moonshot-v1-8k
MODEL_BASE_URL=https://api.deepseek.com/v1
MODEL_NAME=deepseek-chat
MODEL_API_KEY=

# 单次回答的字数上限（越小越省钱，NPC 台词本来就短）
MODEL_MAX_TOKENS=320

# 请求超时（毫秒）
MODEL_TIMEOUT_MS=20000

# ---- 成本保护 ----
# 每天最多真正调用模型多少次，超了就自动回落到本地预设台词
DAILY_MODEL_BUDGET=300
# 同一个访客每 RATE_WINDOW_MS 毫秒内最多问几次
RATE_MAX_PER_WINDOW=14
RATE_WINDOW_MS=300000
# 单次提问的最大字数
MAX_QUESTION_CHARS=160

# ---- 管理员页面 ----
# 打开 /admin 查看玩家记录时要输入的密码，自己设一个，别用 123456
ADMIN_PASSWORD=

# 可选：**给外部试用者（例如比赛评委）的测试口令**，与上面那个并列有效（任一个对上都能进）。
# 为什么要多这一个名字：部署到托管平台后，平台的运行环境变量会盖住 .env.local，
# 于是「改 .env.local 里的 ADMIN_PASSWORD」线上不会生效。换一个平台不会注入的名字，
# 就能在不改正式口令的前提下换掉发出去的那一个。留空 = 不启用。
ADMIN_TEST_PASSWORD=

# ---- 端口 ----
PORT=4180

# ---- 玩家记录与缓存写在哪里 ----
# 留空 = 项目目录下的 data/（本地开发用这个）。
# 部署到 Vercel 这类平台时项目目录是只读的，要改成可写的位置，例如 /tmp/data
DATA_DIR=

# ---- 可选：知乎直答作为附加后端 ----
# 留空则完全不使用。填 auto 表示「优先知乎直答，超额或失败时用上面的 MODEL_*」。
# 注意：知乎直答目前每天只有很少的额度，不建议作为主力。
ZHIHU_ZHIDA_MODE=
# 不填时会尝试从 macOS 钥匙串（服务名 zhihu-cli）读取，不会写进任何文件
ZHIHU_ACCESS_SECRET=

# ---- 知乎 OAuth 登录 ----
# 参赛队伍在活动页点「创建项目」后，赛事会给项目分配一对 App ID / App Key，填在下面。
# 两个都填齐，首页右上角才会出现「用知乎账号登录」的按钮；缺一个就整个入口不显示。
# 这两项都是凭证，**不要提交到仓库、不要写进前端、不要出现在截图和演示视频里**。
ZHIHU_OAUTH_APP_ID=
ZHIHU_OAUTH_APP_KEY=

# 活动页登记的回调地址，必须和这里**完全一致**（协议、域名、路径、尾部斜杠都要一样）。
# 留空 = 按访问域名自动推导，本地开发用这个就行；正式部署建议写死。
# 例：https://your-app.example.com/api/auth/zhihu/callback
ZHIHU_OAUTH_REDIRECT_URI=

# 只有自动化测试才用：把「换 token」的地址指到本地假服务，好处是整条登录链路能离线跑通。
# 正式部署必须留空，否则横幅会一直警告。
ZHIHU_OAUTH_TOKEN_ENDPOINT=
